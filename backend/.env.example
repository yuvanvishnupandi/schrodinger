# SCHRÖDINGER Backend Configuration

# ==========================================
# LLM Forensic Summary API Keys
# ==========================================
# Provide at least one key for the LLM to generate 
# human-readable executive summaries of the forensic analysis.
# Order of preference: Groq > Gemini > OpenAI

GROQ_API_KEY="gsk_your_groq_api_key_here"
GEMINI_API_KEY="AIza_your_gemini_api_key_here"
OPENAI_API_KEY="sk_your_openai_api_key_here"

# ==========================================
# Deep Learning Configuration
# ==========================================
# Set to 'cuda' if NVIDIA GPU is available, else 'cpu'
TORCH_DEVICE="cpu" 
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
